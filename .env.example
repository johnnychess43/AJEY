NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Supabase server-only administrative key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# IntaSend credentials. Keep the secret key and webhook challenge server-side only.
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_CHALLENGE=

# Certificate fees
AJEY_CERTIFICATE_PRICE_KES=500
AJEY_CERTIFICATE_PRICE_USD=5
