NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Supabase server-only administrative key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Flutterwave production credentials (keep server-side only)
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# Certificate fees — set final prices before enabling checkout.
AJEY_CERTIFICATE_PRICE_KES=
AJEY_CERTIFICATE_PRICE_USD=
